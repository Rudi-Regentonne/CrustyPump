# Copy to .env and replace the placeholder values. Do not commit .env.
# No spaces around "=". Use a password of letters and digits only.
# "$" is interpolated by Compose, and "@", ":", "/", and "#" break the database URL.

# Heat pump web UI. Add a port if it is not 80, e.g. 192.168.178.50:8080
HEATPUMP_IP=192.168.178.50
HEATPUMP_PIN=1234

# TimescaleDB password. Compose builds DATABASE_URL from this.
DB_PASSWORD=change-me

# Optional. Six fields, with seconds. Default is once a minute.
CRON_EXPRESSION=0 * * * * *
